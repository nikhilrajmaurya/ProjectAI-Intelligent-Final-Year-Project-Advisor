# ==============================================================================
# AI Project Idea Generator & Mentor - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Server-Side Only - Never Exposed to Client Bundle)
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Application Environment Mode (development / production)
NODE_ENV=development

# Optional Firebase / OAuth Configuration for Production
# VITE_FIREBASE_API_KEY=your_firebase_key
# VITE_FIREBASE_PROJECT_ID=your_project_id
